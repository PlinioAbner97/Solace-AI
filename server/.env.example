# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Get your FREE OpenRouter API key at: https://openrouter.ai/keys
# No credit card required. Free models included.
OPENROUTER_API_KEY=your_openrouter_key_here

# A long random secret for JWT tokens
JWT_SECRET=your_long_random_secret_here

# ── OPTIONAL ──────────────────────────────────────────────────────────────────

PORT=3001
FRONTEND_URL=http://localhost:3000

# AI models to use (these are free on OpenRouter)
CHAT_MODEL=google/gemini-2.0-flash-exp:free
EXTRACT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# NODE_ENV=production
