# Backend environment variables
# Copy this to server/.env and fill in your values

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Get your FREE Gemini API key at: https://aistudio.google.com/app/apikey
# Gemini 1.5 Flash free tier: 1,500 requests/day, 1M tokens/min — no credit card needed
GEMINI_API_KEY=your_gemini_api_key_here

# A long random secret for signing JWT tokens — generate one at: https://generate-secret.vercel.app/32
JWT_SECRET=your_long_random_secret_here

# ── OPTIONAL ──────────────────────────────────────────────────────────────────

# Port the server runs on (default: 3001)
PORT=3001

# Allowed frontend origin(s) — comma-separated for multiple
FRONTEND_URL=http://localhost:3000

# Path for the SQLite database file (default: server/solace.db)
# DB_PATH=./solace.db

# Set to "production" when deploying
# NODE_ENV=production
